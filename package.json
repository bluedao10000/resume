{
  "name": "folio-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "config:generate": "node scripts/configure.mjs",
    "predev": "npm run config:generate",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run config:generate",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test scripts/configure.test.mjs && vitest run",
    "deploy": "npm run build && node scripts/cloudflare.mjs deploy",
    "db:migrate:local": "node scripts/cloudflare.mjs migrate --local",
    "db:migrate:remote": "node scripts/cloudflare.mjs migrate --remote",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "db:generate": "node scripts/generate-auth-schema.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test:live": "FOLIO_LIVE_VALIDATION=1 vitest run src/server/live-validation.test.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.36",
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "better-auth": "1.7.23",
    "dompurify": "3.4.17",
    "lucide-react": "1.72.0",
    "mammoth": "1.13.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-markdown": "2.2.3",
    "mdast-util-to-string": "4.0.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "turndown": "7.2.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "5.20261114.1",
    "@playwright/test": "1.65.1",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
