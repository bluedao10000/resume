  },
  "migrations": [
    {
      "tag": "resume-agent-v1",
      "new_sqlite_classes": [
        "ResumeAgentSession"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "r.story2u.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
