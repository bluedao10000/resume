# Copy to .env and replace the session secret before deployment.
APP_MARKET=cn
APP_MODE=demo
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# The CN defaults use DeepSeek Flash via the Responses API.
AI_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional Better Auth login methods in either market.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Optional Native APIv3 credentials. PEM values may be quoted and multiline.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=

# Deployment target. Supply Cloudflare credentials via the deployment shell.
CLOUDFLARE_WORKER_NAME=folio-resume-cn
CLOUDFLARE_D1_DATABASE_NAME=folio-cn
CLOUDFLARE_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
CLOUDFLARE_CUSTOM_DOMAIN=
CLOUDFLARE_CUSTOM_DOMAIN_ALIAS=
CLOUDFLARE_ANALYTICS_ENABLED=false


# Optional Vibe Pay web payment for the CN market.
ALIPAY_MODE=off
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=
ALIPAY_OPERATOR_USER_ID=
