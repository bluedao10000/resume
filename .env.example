# Copy to .env; this is the only authored configuration file.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_MODE=demo
# APP_MODE=live requires a session and a configured OpenAI-compatible provider.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AGENT_RUNTIME=pi-durable
AGENT_TIMEOUT_MS=45000
AI_CONTEXT_WINDOW=128000
AI_MAX_OUTPUT_TOKENS=12000
AI_MODEL_REASONING=true
# pi API adapter：openai-responses 或 openai-completions
AI_API=openai-responses
AI_REASONING_EFFORT=low
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Credentials may also be supplied by cf-bluedao in the deployment shell.
CLOUDFLARE_WORKER_NAME=folio-resume-agent
CLOUDFLARE_COMPATIBILITY_DATE=2026-11-14
CLOUDFLARE_D1_DATABASE_NAME=folio
CLOUDFLARE_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
CLOUDFLARE_CUSTOM_DOMAIN=
CLOUDFLARE_OBSERVABILITY_ENABLED=true
